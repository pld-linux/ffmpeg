vf_atadenoise.asm is entirely inside %if ARCH_X86_64, so on 32-bit x86 it yields an
empty object that breaks stripping; build only the asm part for x86_64. The C init
file has its own ARCH_X86_64 guard and is called on every x86, so it must stay.

--- ffmpeg-9.0.2/libavfilter/x86/Makefile.orig
+++ ffmpeg-9.0.2/libavfilter/x86/Makefile
@@ -9,8 +9,10 @@
 
 X86ASM-OBJS-$(CONFIG_AFIR_FILTER)            += x86/af_afir.o x86/af_afir_init.o
 X86ASM-OBJS-$(CONFIG_ANLMDN_FILTER)          += x86/af_anlmdn.o x86/af_anlmdn_init.o
-X86ASM-OBJS-$(CONFIG_ATADENOISE_FILTER)      += x86/vf_atadenoise.o           \
-                                                x86/vf_atadenoise_init.o
+ifdef ARCH_X86_64
+X86ASM-OBJS-$(CONFIG_ATADENOISE_FILTER)      += x86/vf_atadenoise.o
+endif
+X86ASM-OBJS-$(CONFIG_ATADENOISE_FILTER)      += x86/vf_atadenoise_init.o
 X86ASM-OBJS-$(CONFIG_BLACKDETECT_FILTER)     += x86/vf_blackdetect.o          \
                                                 x86/vf_blackdetect_init.o
 X86ASM-OBJS-$(CONFIG_BLEND_FILTER)           += x86/vf_blend.o x86/vf_blend_init.o
